{
  "name": "chamelon-browser",
  "version": "0.1.0",
  "description": "A small, independently branded Chromium-based browser for Windows.",
  "main": "src/main.js",
  "author": "Carson",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.carjam120443.chamelonbrowser",
    "productName": "Chamelon Browser",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Chamelon-Browser-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": { "artifactName": "Chamelon-Browser-${version}-portable.${ext}" }
  }
}